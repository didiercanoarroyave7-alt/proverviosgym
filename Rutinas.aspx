<%@ Page Title="Rutinas" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Rutinas.aspx.cs" Inherits="GYMFIT.Rutinas" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<div class="card"><h3>Asignar rutina</h3><div class="grid g2" style="margin-top:.6rem"><div><label for="ddlCliente">Cliente activo</label><asp:DropDownList ID="ddlCliente" runat="server" ClientIDMode="Static"></asp:DropDownList></div><div><label for="ddlObjetivo">Objetivo</label><asp:DropDownList ID="ddlObjetivo" runat="server" ClientIDMode="Static"><asp:ListItem>Hipertrofia</asp:ListItem><asp:ListItem>Pérdida de peso</asp:ListItem><asp:ListItem>Acondicionamiento</asp:ListItem></asp:DropDownList></div></div><div style="margin-top:.8rem"><div><label for="txtDescripcion">Descripción de la rutina</label><asp:TextBox ID="txtDescripcion" runat="server" ClientIDMode="Static" TextMode="MultiLine" Rows="3" /></div></div><div style="margin-top:.8rem"><div><label for="txtObservaciones">Observaciones físicas</label><asp:TextBox ID="txtObservaciones" runat="server" ClientIDMode="Static"  /></div></div><p><asp:Button ID="btnAsignar" runat="server" CssClass="btn" Text="Asignar rutina" OnClick="btnAsignar_Click" /></p><asp:Label ID="lblMensaje" runat="server" CssClass="msg" /></div>
<div class="card"><h3>Rutinas asignadas</h3><asp:Literal ID="litRutinas" runat="server" /></div>
</asp:Content>
