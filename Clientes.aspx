<%@ Page Title="Clientes" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Clientes.aspx.cs" Inherits="GYMFIT.Clientes" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<asp:Panel ID="pnlForm" runat="server" CssClass="card"><h3>Registrar o editar cliente</h3><div class="grid g2" style="margin-top:.6rem"><div><label for="txtDocumento">Documento</label><asp:TextBox ID="txtDocumento" runat="server" ClientIDMode="Static" inputmode="numeric" /></div><div><label for="txtNombre">Nombre completo</label><asp:TextBox ID="txtNombre" runat="server" ClientIDMode="Static"  /></div><div><label for="txtTelefono">Teléfono</label><asp:TextBox ID="txtTelefono" runat="server" ClientIDMode="Static" inputmode="tel" /></div><div><label for="txtContacto">Contacto de emergencia</label><asp:TextBox ID="txtContacto" runat="server" ClientIDMode="Static"  /></div><div><label for="txtTelContacto">Teléfono de emergencia</label><asp:TextBox ID="txtTelContacto" runat="server" ClientIDMode="Static" inputmode="tel" /></div><div><label for="ddlPlan">Plan</label><asp:DropDownList ID="ddlPlan" runat="server" ClientIDMode="Static"></asp:DropDownList></div></div><asp:HiddenField ID="hidEdicion" runat="server" /><p><asp:Button ID="btnGuardar" runat="server" CssClass="btn" Text="Registrar y cobrar" OnClick="btnGuardar_Click" /></p><asp:Label ID="lblMensaje" runat="server" CssClass="msg" /></asp:Panel>
<div class="card"><label for="txtBuscar">Buscar por nombre o documento</label><div class="row"><div><asp:TextBox ID="txtBuscar" runat="server" ClientIDMode="Static" /></div><asp:Button ID="btnBuscar" runat="server" CssClass="btn ghost" Text="Buscar" OnClick="btnBuscar_Click" /></div><asp:Repeater ID="rptClientes" runat="server" OnItemCommand="rptClientes_ItemCommand">
<HeaderTemplate><div class="wrap" style="margin-top:.6rem"><table><thead><tr><th>Documento</th><th>Nombre</th><th>Teléfono</th><th>Membresía</th><th></th></tr></thead><tbody></HeaderTemplate>
<ItemTemplate><tr><td><%#: Eval("Documento") %></td><td><%#: Eval("Nombre") %></td><td><%#: Eval("Telefono") %><br /><span class="mut">Emergencia: <%#: Eval("Contacto") %> <%#: Eval("TelContacto") %></span></td><td><%# GYMFIT.Ui.Estado((GYMFIT.ClienteDemo)Container.DataItem) %></td>
<td><asp:LinkButton runat="server" CommandName="editar" CommandArgument='<%# Eval("Documento") %>' CssClass="chip" Text="Editar" Visible='<%# GYMFIT.Ui.PuedeEditar() %>' /> <asp:LinkButton runat="server" CommandName="eliminar" CommandArgument='<%# Eval("Documento") %>' CssClass="chip" Text="Eliminar" Visible='<%# GYMFIT.Ui.PuedeEditar() %>' /></td></tr></ItemTemplate>
<FooterTemplate></tbody></table></div></FooterTemplate>
</asp:Repeater><asp:Literal ID="litVacio" runat="server" /></div>
</asp:Content>
