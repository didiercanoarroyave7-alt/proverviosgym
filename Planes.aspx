<%@ Page Title="Planes y pagos" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Planes.aspx.cs" Inherits="GYMFIT.Planes" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<div class="grid g4"><asp:Literal ID="litPlanes" runat="server" /></div>
<asp:Panel ID="pnlAdmin" runat="server" CssClass="card"><h3>Crear un plan</h3><div class="grid g2" style="margin-top:.6rem"><div><label for="txtNombrePlan">Nombre del plan</label><asp:TextBox ID="txtNombrePlan" runat="server" ClientIDMode="Static"  /></div><div><label for="txtDias">Duración en días</label><asp:TextBox ID="txtDias" runat="server" ClientIDMode="Static" TextMode="Number" /></div><div><label for="txtPrecio">Precio</label><asp:TextBox ID="txtPrecio" runat="server" ClientIDMode="Static" TextMode="Number" /></div></div><p><asp:Button ID="btnGuardarPlan" runat="server" CssClass="btn" Text="Crear plan" OnClick="btnGuardarPlan_Click" /></p><asp:Label ID="lblMsgPlan" runat="server" CssClass="msg" /></asp:Panel>
<div class="card"><h3>Cobrar o renovar una membresía</h3><div class="grid g2" style="margin-top:.6rem"><div><label for="ddlCliente">Cliente</label><asp:DropDownList ID="ddlCliente" runat="server" ClientIDMode="Static"></asp:DropDownList></div><div><label for="ddlPlanCobro">Plan</label><asp:DropDownList ID="ddlPlanCobro" runat="server" ClientIDMode="Static"></asp:DropDownList></div><div><label for="ddlMetodo">Método de pago</label><asp:DropDownList ID="ddlMetodo" runat="server" ClientIDMode="Static"><asp:ListItem>Efectivo</asp:ListItem><asp:ListItem>Transferencia</asp:ListItem><asp:ListItem>Tarjeta</asp:ListItem></asp:DropDownList></div></div><p><asp:Button ID="btnCobrar" runat="server" CssClass="btn" Text="Cobrar" OnClick="btnCobrar_Click" /></p><asp:Label ID="lblMsgCobro" runat="server" CssClass="msg" /></div>
<div class="card"><h3>Últimos pagos</h3><asp:Literal ID="litPagos" runat="server" /></div>
</asp:Content>
