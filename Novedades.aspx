<%@ Page Title="Novedades" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Novedades.aspx.cs" Inherits="GYMFIT.Novedades" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<div class="card"><h3>Registrar novedad</h3><div class="grid g2" style="margin-top:.6rem"><div><label for="ddlTipo">Tipo</label><asp:DropDownList ID="ddlTipo" runat="server" ClientIDMode="Static"><asp:ListItem>Inicio de turno</asp:ListItem><asp:ListItem>Fin de turno</asp:ListItem><asp:ListItem>Novedad de aseo</asp:ListItem><asp:ListItem>Mantenimiento</asp:ListItem></asp:DropDownList></div><div><label for="txtArea">Área</label><asp:TextBox ID="txtArea" runat="server" ClientIDMode="Static" placeholder="Ej. Zona de pesas" /></div></div><div style="margin-top:.8rem"><div><label for="txtDetalle">Detalle</label><asp:TextBox ID="txtDetalle" runat="server" ClientIDMode="Static" TextMode="MultiLine" Rows="3" /></div></div><p><asp:Button ID="btnRegistrar" runat="server" CssClass="btn" Text="Registrar novedad" OnClick="btnRegistrar_Click" /></p><asp:Label ID="lblMensaje" runat="server" CssClass="msg" /></div>
<div class="card"><h3>Novedades del día</h3><asp:Literal ID="litNovedades" runat="server" /></div>
</asp:Content>
