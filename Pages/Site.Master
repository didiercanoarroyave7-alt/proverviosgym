<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="GYMFIT.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GYMFIT - <%: Page.Title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .sidebar { min-height: 100vh; background: #1a1a2e; }
        .sidebar a { color: #ccc; text-decoration: none; display: block; padding: 10px 20px; }
        .sidebar a:hover, .sidebar a.active { background: #e94560; color: #fff; }
        .brand { color: #e94560; font-weight: 700; letter-spacing: 1px; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-2 sidebar p-0">
                    <div class="p-3">
                        <h5 class="brand">GYMFIT</h5>
                        <small class="text-muted"><asp:Literal ID="litUsuario" runat="server" /></small>
                    </div>
                    <nav>
                        <a href="~/Default.aspx" runat="server">Inicio</a>
                        <a href="~/Pages/ControlAcceso.aspx" runat="server">Control de acceso</a>
                        <a href="~/Pages/Clientes.aspx" runat="server">Clientes</a>
                        <a href="~/Pages/Afiliar.aspx" runat="server">Afiliar membresía</a>
                        <a href="~/Pages/Planes.aspx" runat="server">Planes</a>
                        <hr class="border-secondary" />
                        <asp:LinkButton ID="lnkSalir" runat="server" OnClick="lnkSalir_Click" CssClass="text-danger">Cerrar sesión</asp:LinkButton>
                    </nav>
                </div>
                <div class="col-md-10 p-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>
        </div>
    </form>
</body>
</html>
