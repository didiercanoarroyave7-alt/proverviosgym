<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="GYMFIT.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>GYMFIT</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="~/Content/gymfit.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app">
            <header class="top">
                <div class="brand">GYM<b>FIT</b></div>
                <div><span class="mut"><asp:Literal ID="litUsuario" runat="server" /></span> <a class="btn ghost" href="Login.aspx?salir=1">Salir</a></div>
            </header>
            <nav class="nav" aria-label="Secciones"><asp:Literal ID="litMenu" runat="server" /></nav>
            <main>
                <h1><asp:Literal ID="litTitulo" runat="server" /></h1>
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </main>
        </div>
    </form>
</body>
</html>
